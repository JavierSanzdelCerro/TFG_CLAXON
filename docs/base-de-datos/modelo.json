    {
     "nombre": "ck_usuario_contacto",
     "definicion": "CHECK (((password_hash IS NULL) OR (email IS NOT NULL) OR (telefono IS NOT NULL)))"
    },
    {
     "nombre": "ck_usuario_roles",
     "definicion": "CHECK (((cardinality(roles) >= 1) AND (roles <@ ARRAY['VECINO'::character varying(15), 'FAMILIAR'::character varying(15), 'VENDEDOR'::character varying(15), 'AYUNTAMIENTO'::character varying(15), 'ADMIN'::character varying(15)]) AND fn_sin_repetidos((roles)::text[])))"
    },
    {
     "nombre": "ck_usuario_sin_cuenta",
     "definicion": "CHECK (((password_hash IS NOT NULL) OR (roles = ARRAY['VECINO'::character varying(15)])))"
    },
    {
     "nombre": "ck_usuario_vecino",
     "definicion": "CHECK (((NOT ('VECINO'::text = ANY ((roles)::text[]))) OR (municipio_id IS NOT NULL)))"
    },
    {
     "nombre": "ck_usuario_vendedor",
     "definicion": "CHECK (((NOT ('VENDEDOR'::text = ANY ((roles)::text[]))) OR ((nombre_comercial IS NOT NULL) AND (categoria IS NOT NULL) AND (dias_reparto IS NOT NULL) AND (hora_salida IS NOT NULL))))"
    },
    {
     "nombre": "ck_usuario_verificado",
     "definicion": "CHECK (((email IS NOT NULL) OR (NOT email_verificado)))"
    },
    {
     "nombre": "usuario_categoria_check",
     "definicion": "CHECK (((categoria)::text = ANY ((ARRAY['PAN'::character varying, 'PESCADO'::character varying, 'FRUTA'::character varying, 'CARNE'::character varying, 'ULTRAMARINOS'::character varying, 'OTROS'::character varying])::text[])))"
    },
    {
     "nombre": "usuario_dias_reparto_check",
     "definicion": "CHECK (((dias_reparto)::text ~ '^L?M?X?J?V?S?D?$'::text))"
    },
    {
     "nombre": "usuario_email_check",
     "definicion": "CHECK (((email)::text = lower((email)::text)))"
    },
    {
     "nombre": "usuario_horas_antelacion_encargo_check",
     "definicion": "CHECK (((horas_antelacion_encargo >= 0) AND (horas_antelacion_encargo <= 72)))"
    },
    {
     "nombre": "usuario_idioma_check",
     "definicion": "CHECK (((idioma)::text ~ '^[a-z]{2}(-[A-Z]{2})?$'::text))"
    },
    {
     "nombre": "usuario_tamano_texto_check",
     "definicion": "CHECK (((tamano_texto)::text = ANY ((ARRAY['NORMAL'::character varying, 'GRANDE'::character varying, 'MUY_GRANDE'::character varying])::text[])))"
    }
   ],
