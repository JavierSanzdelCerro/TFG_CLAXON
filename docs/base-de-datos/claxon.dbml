// Claxon · generado por database/herramientas/exportar_modelo.py
// Ábrelo en https://dbdiagram.io (Import → DBML) para moverlo y exportarlo como imagen o PDF.

Project claxon {
  database_type: 'PostgreSQL'
  Note: 'El radar de lo que pasa por tu pueblo. Avisos de servicios ambulantes y encargos.'
}

Table municipio {
  id int [pk, increment]
  nombre varchar(100) [not null, unique]
  comarca varchar(80)
  provincia varchar(60) [not null, default: `'Teruel'::character varying`]
  gestor_id bigint [note: 'Persona del ayuntamiento que publica los avisos. Una secretaria puede llevar varios pueblos.']
  tablon_ubicacion varchar(120)
  tablon_token_hash char(64) [unique, note: 'SHA-256 del enlace secreto del tablón del bar. NULL si el pueblo no tiene tablón.']
  activo bool [not null, default: `true`]
  Note: 'Pueblos donde funciona Claxon.'
}

Table usuario {
  id bigint [pk, increment]
  rol varchar(15) [not null]
  nombre varchar(80) [not null]
  apellidos varchar(120)
  email varchar(150) [unique]
  telefono varchar(20) [unique]
  password_hash varchar(100) [note: 'Hash BCrypt. NULL = vecino sin móvil que gestiona un familiar (no puede entrar).']
  municipio_id int [note: 'Vecino: dónde vive. Vendedor: desde dónde sale.']
  direccion varchar(200)
  necesita_ayuda_entrega bool [not null, default: `false`]
  notas_entrega varchar(300)
  codigo_familia char(6) [unique, note: 'Código de 6 caracteres que el vecino da a un familiar para vincularse.']
  tamano_texto varchar(12) [not null, default: `'GRANDE'::character varying`]
  alto_contraste bool [not null, default: `false`]
  token_push varchar(255) [note: 'Token de Firebase Cloud Messaging del móvil.']
  nombre_comercial varchar(120)
  categoria varchar(15)
  dias_reparto varchar(7) [note: 'Días de la ruta del vendedor: letras de LMXJVSD, por ejemplo «LMXJVS».']
  hora_salida time_without_time_zone [note: 'Hora habitual a la que sale el vendedor.']
  acepta_encargos bool [not null, default: `true`]
  horas_antelacion_encargo smallint [not null, default: `12`]
  activo bool [not null, default: `true`]
  fecha_alta timestamp_with_time_zone [not null, default: `now()`]
  ultimo_acceso timestamp_with_time_zone
  Note: 'Todas las personas: vecinos, familiares, vendedores, ayuntamiento y administración.'
}

Table familiar {
  familiar_id bigint
  vecino_id bigint
  parentesco varchar(30) [not null]
  puede_hacer_encargos bool [not null, default: `true`]
  recibe_avisos bool [not null, default: `true`]
  estado varchar(10) [not null, default: `'PENDIENTE'::character varying`]
  fecha_solicitud timestamp_with_time_zone [not null, default: `now()`]

  indexes {
    (familiar_id, vecino_id) [pk]
  }
  Note: 'Quién ayuda a quién: un familiar puede ayudar a varios vecinos y un vecino tener varios familiares.'
}

Table producto {
  id bigint [pk, increment]
  vendedor_id bigint [not null]
  nombre varchar(100) [not null]
  precio numeric(8,2)
  unidad varchar(10) [not null, default: `'UNIDAD'::character varying`]
  disponible bool [not null, default: `true`]
  Note: 'Catálogo del vendedor. Precio orientativo (NULL = según peso).'
}

Table parada {
  id bigint [pk, increment]
  vendedor_id bigint [not null]
  municipio_id int [not null]
  orden smallint [not null]
  punto_encuentro varchar(100) [not null, default: `'Plaza'::character varying`]
  minutos_desde_salida smallint [not null, note: 'Hora estimada = salida + estos minutos (no hay GPS).']
  fecha date
  hora_estimada timestamp_with_time_zone
  hora_llegada timestamp_with_time_zone
  estado varchar(10) [note: 'PREVISTA: aún no ha salido · EN_CAMINO: ha salido · EN_PARADA: está allí · HECHA · CANCELADA.']
  Note: 'Paradas de la ruta del vendedor, en orden, y cómo va cada una hoy.'
}

Table suscripcion {
  vecino_id bigint
  vendedor_id bigint
  minutos_antelacion smallint [not null, default: `15`]
  activa bool [not null, default: `true`]
  ultimo_aviso date [note: 'Día del último aviso de llegada. Si ya es hoy, no se vuelve a avisar (sin duplicados).']

  indexes {
    (vecino_id, vendedor_id) [pk]
  }
  Note: 'De qué vendedores quiere aviso cada vecino y con cuánta antelación.'
}

Table encargo {
  id bigint [pk, increment]
  vecino_id bigint [not null]
  parada_id bigint [not null]
  fecha_entrega date [not null]
  estado varchar(12) [not null, default: `'PENDIENTE'::character varying`]
  creado_por_id bigint [not null, note: 'El propio vecino o un familiar en su nombre.']
  a_domicilio bool [not null, default: `false`]
  notas varchar(300)
  motivo_rechazo varchar(200)
  importe_total numeric(8,2) [note: 'Lo pone el vendedor al prepararlo (los productos a peso varían).']
  fecha_creacion timestamp_with_time_zone [not null, default: `now()`]
  fecha_aceptado timestamp_with_time_zone
  fecha_preparado timestamp_with_time_zone
  fecha_entregado timestamp_with_time_zone
  Note: 'Pedido para recoger cuando pase el vendedor. El vendedor es el de la parada. Se paga en mano.'
}

Table linea_encargo {
  id bigint [pk, increment]
  encargo_id bigint [not null]
  producto_id bigint
  descripcion varchar(150) [not null, note: 'Copia del nombre del producto o texto libre («barra de centeno si hay»).']
  cantidad numeric(7,2) [not null]
  unidad varchar(10) [not null, default: `'UNIDAD'::character varying`]
  precio_unitario numeric(8,2)
  Note: 'Cada producto del encargo.'
}

Table consulta {
  id bigint [pk, increment]
  municipio_id int [not null]
  tipo varchar(12) [not null, default: `'MEDICINA'::character varying`]
  dia_semana smallint [note: 'ISO 8601: 1 = lunes ... 7 = domingo (como DayOfWeek de Java).']
  fecha date
  hora_inicio time_without_time_zone [not null]
  hora_fin time_without_time_zone [not null]
  lugar varchar(120) [not null, default: `'Consultorio local'::character varying`]
  cancelada bool [not null, default: `false`]
  motivo varchar(200) [note: 'Motivo genérico del cambio. Nunca datos de salud.']
  Note: 'Horario de consulta médica. Con dia_semana es el horario habitual; con fecha, un cambio de ese día.'
}

Table aviso {
  id bigint [pk, increment]
  municipio_id int [note: 'NULL = para todos los pueblos.']
  autor_id bigint [not null]
  categoria varchar(12) [not null, default: `'GENERAL'::character varying`]
  titulo varchar(120) [not null]
  contenido text [not null]
  prioridad varchar(10) [not null, default: `'NORMAL'::character varying`]
  estado varchar(10) [not null, default: `'BORRADOR'::character varying`]
  enviar_push bool [not null, default: `true`]
  push_enviado timestamp_with_time_zone [note: 'Cuándo se mandó la notificación. Si ya tiene fecha, no se vuelve a mandar.']
  visible_desde timestamp_with_time_zone [not null, default: `now()`]
  visible_hasta timestamp_with_time_zone
  fecha_creacion timestamp_with_time_zone [not null, default: `now()`]
  Note: 'Avisos del ayuntamiento. Si va a dos pueblos, se guarda una fila por pueblo.'
}

Ref: aviso.municipio_id > municipio.id
Ref: aviso.autor_id > usuario.id
Ref: consulta.municipio_id > municipio.id
Ref: encargo.vecino_id > usuario.id
Ref: encargo.parada_id > parada.id
Ref: encargo.creado_por_id > usuario.id
Ref: familiar.familiar_id > usuario.id [delete: cascade]
Ref: familiar.vecino_id > usuario.id [delete: cascade]
Ref: linea_encargo.encargo_id > encargo.id [delete: cascade]
Ref: linea_encargo.producto_id > producto.id [delete: set null]
Ref: municipio.gestor_id > usuario.id [delete: set null]
Ref: parada.vendedor_id > usuario.id [delete: cascade]
Ref: parada.municipio_id > municipio.id
Ref: producto.vendedor_id > usuario.id [delete: cascade]
Ref: suscripcion.vecino_id > usuario.id [delete: cascade]
Ref: suscripcion.vendedor_id > usuario.id [delete: cascade]
Ref: usuario.municipio_id > municipio.id

TableGroup personas {
  municipio
  usuario
  familiar
}
TableGroup vendedores {
  producto
  parada
  suscripcion
}
TableGroup encargos {
  encargo
  linea_encargo
}
TableGroup ayuntamiento {
  consulta
  aviso
}
